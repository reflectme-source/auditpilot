{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Rights Evidence v1",
  "description": "Provider-neutral evidence describing a point-in-time source-rights declaration observation. It is not a licence, permission, ownership determination, or compliance conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "intended_use",
    "observation",
    "integrity",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "source-rights-evidence/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "identity"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "value"],
          "properties": {
            "scheme": {
              "const": "canonical_uri"
            },
            "value": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "user_class": {
          "type": ["string", "null"],
          "maxLength": 64
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_state",
        "observed_at",
        "expires_at",
        "evidence_ref",
        "source_hashes",
        "license_refs"
      ],
      "properties": {
        "declaration_state": {
          "enum": [
            "declared_permitted_for_purpose",
            "declared_prohibited_for_purpose",
            "license_required",
            "no_machine_readable_declaration_observed",
            "conflict",
            "unknown"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^urn:sha256:[0-9a-f]{64}$"
        },
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "license_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "signature_algorithm",
        "signer_key_id",
        "key_fingerprint",
        "verified_at",
        "raw_artifact_sha256"
      ],
      "properties": {
        "verification_status": {
          "enum": [
            "verified",
            "failed",
            "untrusted_key",
            "not_checked"
          ]
        },
        "signature_algorithm": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "signer_key_id": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "key_fingerprint": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "raw_artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_clearance", "requires_human_review"],
      "properties": {
        "legal_clearance": {
          "const": false
        },
        "requires_human_review": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})T(?:[0-9]{2}:[0-9]{2}:[0-9]{2})(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
