{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Rights Evidence v1",
  "description": "Provider-neutral, point-in-time source-rights observation for human review. This artifact is evidence, not permission, a licence, ownership proof, or a compliance conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "intended_use",
    "observation",
    "integrity",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": "source-rights-evidence/1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "identity"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "value"],
          "properties": {
            "scheme": {
              "const": "canonical_uri"
            },
            "value": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "user_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_state",
        "observed_at",
        "evidence_ref",
        "source_hashes"
      ],
      "properties": {
        "declaration_state": {
          "enum": [
            "declared_permitted_for_purpose",
            "declared_prohibited_for_purpose",
            "license_required",
            "no_machine_readable_declaration_observed",
            "conflict",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "license_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "signature_algorithm",
        "signer_key_id",
        "key_fingerprint",
        "verified_at",
        "raw_artifact_sha256"
      ],
      "properties": {
        "verification_status": {
          "enum": ["verified", "failed", "untrusted_key", "not_checked"]
        },
        "signature_algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "raw_artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_clearance", "requires_human_review"],
      "properties": {
        "legal_clearance": {
          "const": false
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    }
  }
}
